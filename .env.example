# Novel Writer — API Keys & Configuration
# Copy this file to .env and fill in your keys

# ── Required ──────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional: Gemini fallback ─────────────────────────────
# GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model overrides (defaults shown) ─────────────────────
# LLM_MODEL=openrouter/free
# STRATEGY_MODEL=openrouter/free
# WRITER_MODEL=openrouter/free
# EDITOR_MODEL=openrouter/free

# ── Generation settings ──────────────────────────────────
# CHAPTER_COUNT=10
# TARGET_WORDS_PER_CHAPTER=1500
# MAX_RETRIES=3
# TEMPERATURE=0.8
# MAX_TOKENS=5000
